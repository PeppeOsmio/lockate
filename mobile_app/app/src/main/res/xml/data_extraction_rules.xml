<?xml version="1.0" encoding="utf-8"?>
<!--
   The database holds secrets encrypted with this phone's Keystore (group keys, push keys, API
   keys), which another phone can't decrypt, and the preferences point into it: neither is backed
   up nor moved to a new phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
